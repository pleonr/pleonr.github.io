{
  "permissions": {
    "allow": [
      "WebFetch(domain:www.leon.dev.br)",
      "Bash(curl -s -A \"Mozilla/5.0\" http://www.leon.dev.br/sobre/)",
      "Bash(npm run *)",
      "Bash(curl -s \"https://api.github.com/repos/tonimercadante/alucard-theme/contents/\")",
      "Bash(curl -s \"https://api.github.com/repos/tonimercadante/alucard-theme/contents/themes\")",
      "Bash(curl -s \"https://raw.githubusercontent.com/tonimercadante/alucard-theme/main/themes/alucard-color-theme.json\" -o /tmp/alucard-color-theme.json)",
      "Read(//tmp/**)",
      "Bash(npm --version)",
      "Bash(pip3 --version)",
      "Bash(set -e)",
      "Bash(curl -s -o /tmp/reg.json -w '%{http_code}\\\\n' -X POST http://localhost:8000/auth/registrar -H 'Content-Type: application/json' -d '{\"nome\": \"Ana Silva\", \"email\": \"ana@exemplo.com\", \"senha\": \"senhaForte123\"}')",
      "Bash(curl -s -o /tmp/login.json -w '%{http_code}\\\\n' -X POST http://localhost:8000/auth/login -H 'Content-Type: application/json' -d '{\"email\": \"ana@exemplo.com\", \"senha\": \"senhaForte123\"}')",
      "Bash(python3 -c \"import json;print\\(json.load\\(open\\('/tmp/login.json'\\)\\)['token']\\)\")",
      "Bash(curl -s -o /tmp/list.json -w '%{http_code}\\\\n' http://localhost:8000/usuarios -H 'Authorization: Bearer __TRACKED_VAR__')"
    ]
  }
}
