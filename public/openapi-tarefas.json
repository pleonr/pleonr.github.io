{
  "openapi": "3.1.0",
  "info": {
    "title": "API de Tarefas",
    "version": "1.0.0",
    "description": "A mesma API construída nas Aulas 05 (Node.js + Express) e 06 (Python + FastAPI) de APIs e Microsserviços. Rode uma das duas implementações localmente antes de testar os endpoints abaixo."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Node.js + Express (Aula 05)"
    },
    {
      "url": "http://localhost:8000",
      "description": "Python + FastAPI (Aula 06)"
    }
  ],
  "tags": [
    {
      "name": "Tarefas",
      "description": "Criar, listar, atualizar e remover tarefas"
    }
  ],
  "paths": {
    "/tarefas": {
      "get": {
        "operationId": "listTarefas",
        "tags": ["Tarefas"],
        "summary": "Listar tarefas",
        "description": "Retorna todas as tarefas cadastradas.",
        "responses": {
          "200": {
            "description": "Lista de tarefas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Tarefa" }
                },
                "example": [
                  { "id": 1, "titulo": "Estudar Node.js", "concluida": false },
                  { "id": 2, "titulo": "Estudar FastAPI", "concluida": false }
                ]
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTarefa",
        "tags": ["Tarefas"],
        "summary": "Criar tarefa",
        "description": "Cria uma nova tarefa.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NovaTarefa" },
              "example": { "titulo": "Aprender Express" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tarefa criada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tarefa" },
                "example": { "id": 3, "titulo": "Aprender Express", "concluida": false }
              }
            }
          },
          "400": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "VALIDATION_ERROR", "message": "O campo 'titulo' é obrigatório." } }
              }
            }
          }
        }
      }
    },
    "/tarefas/{id}": {
      "get": {
        "operationId": "getTarefa",
        "tags": ["Tarefas"],
        "summary": "Buscar tarefa",
        "description": "Retorna uma única tarefa pelo id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id da tarefa",
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "A tarefa",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tarefa" },
                "example": { "id": 1, "titulo": "Estudar Node.js", "concluida": false }
              }
            }
          },
          "404": {
            "description": "Tarefa não encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "NOT_FOUND", "message": "Tarefa não encontrada." } }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceTarefa",
        "tags": ["Tarefas"],
        "summary": "Substituir tarefa",
        "description": "Substitui a tarefa inteira.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id da tarefa",
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NovaTarefa" },
              "example": { "titulo": "Estudar Node.js a fundo", "concluida": true }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarefa atualizada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tarefa" },
                "example": { "id": 1, "titulo": "Estudar Node.js a fundo", "concluida": true }
              }
            }
          },
          "400": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "VALIDATION_ERROR", "message": "O campo 'titulo' é obrigatório." } }
              }
            }
          },
          "404": {
            "description": "Tarefa não encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "NOT_FOUND", "message": "Tarefa não encontrada." } }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateTarefa",
        "tags": ["Tarefas"],
        "summary": "Atualizar parcialmente",
        "description": "Atualiza apenas os campos enviados.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id da tarefa",
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AtualizarTarefa" },
              "example": { "concluida": true }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarefa atualizada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Tarefa" },
                "example": { "id": 1, "titulo": "Estudar Node.js", "concluida": true }
              }
            }
          },
          "404": {
            "description": "Tarefa não encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "NOT_FOUND", "message": "Tarefa não encontrada." } }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteTarefa",
        "tags": ["Tarefas"],
        "summary": "Remover tarefa",
        "description": "Remove uma tarefa pelo id.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Id da tarefa",
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "204": {
            "description": "Tarefa removida"
          },
          "404": {
            "description": "Tarefa não encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": { "code": "NOT_FOUND", "message": "Tarefa não encontrada." } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Tarefa": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "titulo": { "type": "string", "example": "Estudar Node.js" },
          "concluida": { "type": "boolean", "example": false }
        },
        "required": ["id", "titulo", "concluida"]
      },
      "NovaTarefa": {
        "type": "object",
        "properties": {
          "titulo": { "type": "string", "example": "Estudar Node.js" },
          "concluida": { "type": "boolean", "example": false }
        },
        "required": ["titulo"]
      },
      "AtualizarTarefa": {
        "type": "object",
        "properties": {
          "titulo": { "type": "string", "example": "Estudar Node.js" },
          "concluida": { "type": "boolean", "example": true }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "NOT_FOUND" },
              "message": { "type": "string", "example": "Tarefa não encontrada." }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      }
    }
  }
}
